{
  "name": "@tscircuit/infer-sch-symbol",
  "version": "0.0.0",
  "description": "Infer tscircuit schematic symbols and pin arrangements from component pin metadata and footprints",
  "type": "module",
  "types": "lib/index.ts",
  "exports": {
    ".": "./lib/index.ts"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "gallery": "bun scripts/render-gallery.tsx",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "start": "cosmos",
    "build:site": "cosmos-export"
  },
  "dependencies": {
    "@tscircuit/footprinter": "0.0.430",
    "circuit-json": "0.0.525",
    "schematic-symbols": "0.0.248"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tscircuit/alphabet": "0.0.25",
    "@tscircuit/circuit-json-util": "0.0.119",
    "@tscircuit/core": "0.0.2079",
    "@tscircuit/math-utils": "0.0.38",
    "@tscircuit/props": "0.0.685",
    "@types/bun": "^1.2.16",
    "@types/react": "^19.1.8",
    "bun-match-svg": "0.0.17",
    "circuit-json-to-connectivity-map": "0.0.33",
    "circuit-to-svg": "0.0.438",
    "react": "19.2.6",
    "react-cosmos": "7.4.1",
    "react-cosmos-plugin-vite": "7.4.0",
    "react-dom": "19.2.6",
    "typescript": "^5.0.0",
    "vite": "7.3.1"
  },
  "peerDependencies": {
    "@tscircuit/props": ">=0.0.685"
  },
  "module": "lib/index.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tscircuit/infer-sch-symbol.git"
